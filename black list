	IconBtn.Text = iconText
	IconBtn.TextSize = 20
	IconBtn.BackgroundTransparency = 1
	if iconText == "☀️" then
		IconBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	else
		IconBtn.TextColor3 = Color3.fromRGB(100, 100, 110)
	end

	IconBtn.MouseButton1Click:Connect(function()
		SunPage.Visible = false
		if iconText == "☀️" then
			SunPage.Visible = true
		end
	end)
end

----------------------------------------------------------------
-- ⚙️ Window Mechanics
----------------------------------------------------------------
local function setMenuVisible(visible)
	MainFrame.Visible = visible
	OpenButton.Visible = not visible
	if visible then
		SunPage.Visible = true
	else
		SunPage.Visible = false
	end
end

CloseButton.MouseButton1Click:Connect(function() setMenuVisible(false) end)
OpenButton.MouseButton1Click:Connect(function() setMenuVisible(true) end)

