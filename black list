-- 🟢 【完全再現】実際に指でスライドしていじれる本物のゲージ（スライダー）関数
local function createRealSlider(parent, text, defaultVal)
	local container = Instance.new("Frame", parent)
	container.Size = UDim2.new(1, -10, 0, 45)
	container.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)
	
	local lbl = Instance.new("TextLabel", container)
	lbl.Size = UDim2.new(1, -60, 0, 20)
	lbl.Position = UDim2.new(0, 10, 0, 5)
	lbl.Text = text
	lbl.TextColor3 = Color3.fromRGB(200, 200, 205)
	lbl.TextSize = 13
	lbl.Font = Enum.Font.SourceSansBold
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.BackgroundTransparency = 1
	
	local valueLbl = Instance.new("TextLabel", container)
	valueLbl.Size = UDim2.new(0, 50, 0, 20)
	valueLbl.Position = UDim2.new(1, -60, 0, 5)
	valueLbl.Text = tostring(defaultVal) .. "%"
	valueLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
	valueLbl.TextSize = 12
	valueLbl.TextXAlignment = Enum.TextXAlignment.Right
	valueLbl.BackgroundTransparency = 1
	
	local slideBG = Instance.new("TextButton", container)
	slideBG.Size = UDim2.new(1, -20, 0, 6)
	slideBG.Position = UDim2.new(0, 10, 0, 30)
	slideBG.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
	slideBG.Text = ""
	slideBG.BorderSizePixel = 0
	Instance.new("UICorner", slideBG).CornerRadius = UDim.new(0, 3)
	
	local slideFill = Instance.new("Frame", slideBG)
	slideFill.Size = UDim2.new(defaultVal/100, 0, 1, 0)
	slideFill.BackgroundColor3 = Color3.fromRGB(230, 80, 20) -- オレンジのバー
	slideFill.BorderSizePixel = 0
	Instance.new("UICorner", slideFill).CornerRadius = UDim.new(0, 3)
	
	-- スライダーをドラッグして数値を変えられる本物のロジック
	local dragging = false
	local function updateSlider(input)
		local posX = math.clamp((input.Position.X - slideBG.AbsolutePosition.X) / slideBG.AbsoluteSize.X, 0, 1)
		slideFill.Size = UDim2.new(posX, 0, 1, 0)
		valueLbl.Text = tostring(math.round(posX * 100)) .. "%"
	end
	slideBG.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true updateSlider(input)
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateSlider(input)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

-- 🟢 【完全再現】実際にクリックでON/OFFをいじれる本物のボタン（トグル）関数
local function createRealToggle(parent, text)
	local container = Instance.new("Frame", parent)
	container.Size = UDim2.new(1, -10, 0, 35)
	container.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)
	
	local lbl = Instance.new("TextLabel", container)
	lbl.Size = UDim2.new(1, -60, 1, 0)
	lbl.Position = UDim2.new(0, 10, 0, 0)
	lbl.Text = "☐  " .. text
	lbl.TextColor3 = Color3.fromRGB(160, 160, 165)
	lbl.TextSize = 13
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.BackgroundTransparency = 1
	
	local toggleBtn = Instance.new("TextButton", container)
	toggleBtn.Size = UDim2.new(1, 0, 1, 0)
	toggleBtn.BackgroundTransparency = 1
	toggleBtn.Text = ""
	
	local enabled = false
	toggleBtn.MouseButton1Click:Connect(function()
		enabled = not enabled
		if enabled then
			lbl.Text = "☑  " .. text
			lbl.TextColor3 = Color3.fromRGB(0, 120, 255) -- ONになると青く光る
		else
			lbl.Text = "☐  " .. text
			lbl.TextColor3 = Color3.fromRGB(160, 160, 165)
		end
	end)
end

