-- 見本画像にある「スライダー要素」を右側スクロール内に配置
local function createSliderDisplay(text, percent)
	local container = Instance.new("Frame", RightScroll)
	container.Size = UDim2.new(1, -10, 0, 35)
	container.BackgroundTransparency = 1
	container.LayoutOrder = 1
	
	local lbl = Instance.new("TextLabel", container)
	lbl.Size = UDim2.new(1, 0, 0, 15)
	lbl.Text = "  " .. text
	lbl.TextColor3 = Color3.fromRGB(180, 180, 185)
	lbl.TextSize = 11
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.BackgroundTransparency = 1
	
	local bg = Instance.new("Frame", container)
	bg.Size = UDim2.new(1, -10, 0, 4)
	bg.Position = UDim2.new(0, 5, 0, 18)
	bg.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
	bg.BorderSizePixel = 0
	
	local fill = Instance.new("Frame", bg)
	fill.Size = UDim2.new(percent, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(230, 80, 20) -- Orange color from image
	
	local pText = Instance.new("TextLabel", container)
	pText.Size = UDim2.new(0, 40, 0, 15)
	pText.Position = UDim2.new(1, -45, 0, 18)
	pText.Text = tostring(percent * 100) .. "%"
	pText.TextColor3 = Color3.fromRGB(150, 150, 150)
	pText.TextSize = 10
	pText.TextXAlignment = Enum.TextXAlignment.Right
	pText.BackgroundTransparency = 1
end

-- スライダーの作成（見本画像のEffectsセクション再現）
