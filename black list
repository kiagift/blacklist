-- ESPシステム本体
local function updateEspVisuals(active)
	currentSettings.EspEnabled = active
	if active then
		EspLbl.Text = "☑  Player ESP (Green Highlight)"
		EspLbl.TextColor3 = Color3.fromRGB(160, 210, 20)
		task.spawn(function()
			while currentSettings.EspEnabled do
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and p.Character then
						local hl = p.Character:FindFirstChild("YokaiESP")
						if not hl then
							hl = Instance.new("Highlight")
							hl.Name = "YokaiESP"
							hl.FillColor = Color3.fromRGB(160, 210, 20)
							hl.FillTransparency = 0.4
							hl.OutlineColor = Color3.fromRGB(255, 255, 255)
							hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
							hl.Parent = p.Character
						end
					end
				end
				task.wait(1)
			end
		end)
	else
		EspLbl.Text = "☐  Player ESP (Green Highlight)"
		EspLbl.TextColor3 = Color3.fromRGB(160, 160, 165)
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character and p.Character:FindFirstChild("YokaiESP") then p.Character.YokaiESP:Destroy() end
		end
	end
end
EspBtn.MouseButton1Click:Connect(function() updateEspVisuals(not currentSettings.EspEnabled) end)

local function createRealSlider(parent, text, settingKey, defaultVal)
	local container = Instance.new("Frame", parent)
	container.Size = UDim2.new(1, -10, 0, 45)
	container.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	Instance.new("UICorner", container).CornerRadius = UDim.new(0, 6)
	
	local lbl = Instance.new("TextLabel", container)
	lbl.Size = UDim2.new(1, -70, 0, 20)
	lbl.Position = UDim2.new(0, 12, 0, 5)
	lbl.Text = text
	lbl.TextColor3 = Color3.fromRGB(200, 200, 205)
	lbl.TextSize = 13
	lbl.Font = Enum.Font.SourceSansBold
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.BackgroundTransparency = 1
	
	local valueLbl = Instance.new("TextLabel", container)
	valueLbl.Size = UDim2.new(0, 50, 0, 20)
	valueLbl.Position = UDim2.new(1, -62, 0, 5)
	valueLbl.Text = tostring(defaultVal) .. "%"
	valueLbl.TextColor3 = Color3.fromRGB(150, 150, 155)
	valueLbl.TextSize = 12
	valueLbl.TextXAlignment = Enum.TextXAlignment.Right
	valueLbl.BackgroundTransparency = 1
	
	local slideBG = Instance.new("TextButton", container)
	slideBG.Size = UDim2.new(1, -24, 0, 6)
	slideBG.Position = UDim2.new(0, 12, 0, 30)
	slideBG.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
	slideBG.Text = ""
	Instance.new("UICorner", slideBG).CornerRadius = UDim.new(0, 3)
	
	local slideFill = Instance.new("Frame", slideBG)
	slideFill.Size = UDim2.new(defaultVal / 100, 0, 1, 0)
	slideFill.BackgroundColor3 = Color3.fromRGB(160, 210, 20)
	Instance.new("UICorner", slideFill).CornerRadius = UDim.new(0, 3)
	
	local dragging = false
	local function updateSlider(input)
		local posX = math.clamp((input.Position.X - slideBG.AbsolutePosition.X) / slideBG.AbsoluteSize.X, 0, 1)
		slideFill.Size = UDim2.new(posX, 0, 1, 0)
		local finalVal = math.round(posX * 100)
		valueLbl.Text = tostring(finalVal) .. "%"
		currentSettings[settingKey] = finalVal
	end
	slideBG.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true updateSlider(input) end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateSlider(input) end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
end

