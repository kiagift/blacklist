local function setMenuVisible(visible)
	MainFrame.Visible = visible
	OpenButton.Visible = not visible -- メニューを開いたらOpenボタンを隠し、閉じたら出す
end

CloseButton.MouseButton1Click:Connect(function() setMenuVisible(false) end)
OpenButton.MouseButton1Click:Connect(function() setMenuVisible(true) end)

game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.M then
		setMenuVisible(not MainFrame.Visible)
	end
end)

----------------------------------------------------------------
-- 👥 Draw List (Crash-proof version)
----------------------------------------------------------------
local function drawList()
	for _, child in ipairs(ScrollingFrame:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end

	local order = 1

	local function addPlayerEntry(player, status)
		local entry = Instance.new("Frame", ScrollingFrame)
		entry.Size = UDim2.new(1, -8, 0, 48)
		entry.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
		entry.BorderSizePixel = 0
		entry.LayoutOrder = order
		order = order + 1
		
		local E_Corner = Instance.new("UICorner", entry)
		E_Corner.CornerRadius = UDim.new(0, 6)

		local stroke = Instance.new("UIStroke", entry)
		stroke.Color = Color3.fromRGB(0, 120, 255)
		stroke.Thickness = 2
		stroke.Enabled = false

		local nameLabel = Instance.new("TextLabel", entry)
		nameLabel.Size = UDim2.new(1, -15, 1, 0)
		nameLabel.Position = UDim2.new(0, 15, 0, 0)
		nameLabel.BackgroundTransparency = 1
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.TextSize = 14
		nameLabel.Font = Enum.Font.SourceSansBold
		nameLabel.Text = player.Name
		
		if status == "Me" then
			nameLabel.Text = player.Name .. " (You)"
			nameLabel.TextColor3 = Color3.fromRGB(0, 220, 255)
		elseif status == "Blacklist" then
			nameLabel.TextColor3 = Color3.fromRGB(255, 60, 60)
		else
			nameLabel.TextColor3 = Color3.fromRGB(160, 160, 170)
		end
		
		if player ~= LocalPlayer then
			local selectBtn = Instance.new("TextButton", entry)
			selectBtn.Size = UDim2.new(1, 0, 1, 0)
			selectBtn.BackgroundTransparency = 1
			selectBtn.Text = ""
			selectBtn.MouseButton1Click:Connect(function()
				for _, v in ipairs(ScrollingFrame:GetChildren()) do
					if v:IsA("Frame") and v:FindFirstChild("UIStroke") then v.UIStroke.Enabled = false end
				end
				stroke.Enabled = true
				selectedPlayer = player
			end)
		end
	end
	
	-- 一番上に自分を表示
	addPlayerEntry(LocalPlayer, "Me")
	
	-- 安全に他の全プレイヤーをロード
	local allPlayers = Players:GetPlayers()
	for i = 1, #allPlayers do
		local p = allPlayers[i]
		if p and p ~= LocalPlayer and p.Parent then
			if isBlacklisted(p.UserId) then 
				addPlayerEntry(p, "Blacklist") 
			else 
				addPlayerEntry(p, "Normal") 
			end
		end
	end
end

drawList()

AddButton.MouseButton1Click:Connect(function()
	if selectedPlayer and (TextBox.Text == "C" or TextBox.Text == "c") then
		table.insert(BlacklistIds, selectedPlayer.UserId)
		drawList()
		TextBox.Text = ""
		selectedPlayer = nil
	end
end)

-- 接続バグを完全に修正した安全なループ監視
task.spawn(function()
	while task.wait(2) do
