----------------------------------------------------------------
-- 3. リストの描画処理（起動エラー対策済み）
----------------------------------------------------------------
local function drawList()
	for _, child in ipairs(ScrollingFrame:GetChildren()) do
		if child:IsA("Frame") then 
			child:Destroy() 
		end
	end

	local order = 1

	local function addPlayerEntry(player, status)
		local entry = Instance.new("Frame", ScrollingFrame)
		entry.Size = UDim2.new(1, -10, 0, 45)
		entry.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		entry.LayoutOrder = order
		order = order + 1
		
		local stroke = Instance.new("UIStroke", entry)
		stroke.Color = Color3.fromRGB(255, 255, 255)
		stroke.Enabled = false
		
		local img = Instance.new("ImageLabel", entry)
		img.Size = UDim2.new(0, 35, 0, 35)
		img.Position = UDim2.new(0, 5, 0, 5)
		img.BackgroundTransparency = 1
		
		local nameLabel = Instance.new("TextLabel", entry)
		nameLabel.Size = UDim2.new(1, -50, 1, 0)
		nameLabel.Position = UDim2.new(0, 45, 0, 0)
		nameLabel.BackgroundTransparency = 1
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.Text = player.Name
		
		if status == "Me" then
			nameLabel.Text = player.Name .. "(あなた)"
			nameLabel.TextColor3 = Color3.fromRGB(0, 220, 255)
		elseif status == "Blacklist" then
			nameLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
		else
			nameLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		end
		
		-- アバター読み込みが遅れても、画面の起動を邪魔しないように安全に隔離処理
		task.spawn(function()
			pcall(function() 
				img.Image = Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100) 
			end)
		end)
		
		if player ~= LocalPlayer then
			local selectBtn = Instance.new("TextButton", entry)
			selectBtn.Size = UDim2.new(1, 0, 1, 0)
			selectBtn.BackgroundTransparency = 1
			selectBtn.Text = ""
			selectBtn.MouseButton1Click:Connect(function()
				for _, v in ipairs(ScrollingFrame:GetChildren()) do
					if v:IsA("Frame") and v:FindFirstChild("UIStroke") then 
						v.UIStroke.Enabled = false 
					end
				end
				stroke.Enabled = true
				selectedPlayer = player
			end)
		end
	end
	
	-- 自分を追加
	addPlayerEntry(LocalPlayer, "Me")
	-- 他のプレイヤーを追加
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then 
			if isBlacklisted(player.UserId) then
				addPlayerEntry(player, "Blacklist")
			else
				addPlayerEntry(player, "Normal")
			end
		end
	end
end

-- リストを描画
drawList()

