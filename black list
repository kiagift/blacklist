-- 🗂️ タブ切り替えボタンの生成
----------------------------------------------------------------
local Tabs = { ["☀️"] = SunPage, ["⚙️"] = GearPage }
local TabOrder = {"☀️", "⚙️"}

for index, icon in ipairs(TabOrder) do
	local page = Tabs[icon]
	local TabBtn = Instance.new("TextButton", Sidebar)
	TabBtn.Size = UDim2.new(0, 40, 0, 40)
	TabBtn.Position = UDim2.new(0.5, -20, 0, 60 + (index - 1) * 55)
	TabBtn.Text = icon
	TabBtn.TextSize = 18
	TabBtn.BackgroundTransparency = 1
	TabBtn.TextColor3 = Color3.fromRGB(100, 100, 110)
	
	TabBtn.MouseButton1Click:Connect(function()
		SunPage.Visible = false
		GearPage.Visible = false
		page.Visible = true
		
		for _, child in ipairs(Sidebar:GetChildren()) do
			if child:IsA("TextButton") then 
				child.TextColor3 = Color3.fromRGB(100, 100, 110) 
			end
		end
		TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	end)
end

----------------------------------------------------------------
-- ⚙️ 完璧な開閉ロジック（ボタン・キー同時フリーズ対策）
----------------------------------------------------------------
local function setMenuVisible(visible)
	MainFrame.Visible = visible
	OpenButton.Visible = not visible
	if visible then 
		GearPage.Visible = true -- 開いた時は確実にブラックリスト（歯車）側を初期表示に固定
		for _, child in ipairs(Sidebar:GetChildren()) do
			if child:IsA("TextButton") and child.Text == "⚙️" then
				child.TextColor3 = Color3.fromRGB(255, 255, 255)
			elseif child:IsA("TextButton") then
				child.TextColor3 = Color3.fromRGB(100, 100, 110)
			end
		end
	else
		SunPage.Visible = false
		GearPage.Visible = false
	end
end

-- タップ時の処理を完全に一本化
CloseButton.MouseButton1Click:Connect(function() setMenuVisible(false) end)
OpenButton.MouseButton1Click:Connect(function() setMenuVisible(true) end)

-- カスタム開閉キーの監視
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == TOGGLE_KEY then 
		setMenuVisible(not MainFrame.Visible) 
	end
end)

