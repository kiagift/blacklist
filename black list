-- ① チェックボックス（緑発光仕様）
local function createMenuToggle(parent, text)
	local item = Instance.new("Frame", parent)
	item.Size = UDim2.new(1, -10, 0, 24)
	item.BackgroundTransparency = 1
	
	local box = Instance.new("TextButton", item)
	box.Size = UDim2.new(0, 12, 0, 12)
	box.Position = UDim2.new(0, 10, 0.5, -6)
	box.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
	box.Text = ""
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 2)
	local stroke = Instance.new("UIStroke", box)
	stroke.Color = Color3.fromRGB(55, 55, 60)
	stroke.Thickness = 1
	
	local lbl = Instance.new("TextLabel", item)
	lbl.Size = UDim2.new(1, -35, 1, 0)
	lbl.Position = UDim2.new(0, 30, 0, 0)
	lbl.Text = text
	lbl.TextColor3 = Color3.fromRGB(150, 150, 155)
	lbl.TextSize = 12
	lbl.Font = Enum.Font.SourceSans
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.BackgroundTransparency = 1
	
	local active = false
	box.MouseButton1Click:Connect(function()
		active = not active
		if active then
			box.BackgroundColor3 = Color3.fromRGB(160, 210, 20) -- 見本通りのライムグリーン
			stroke.Color = Color3.fromRGB(160, 210, 20)
			lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
		else
			box.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
			stroke.Color = Color3.fromRGB(55, 55, 60)
			lbl.TextColor3 = Color3.fromRGB(150, 150, 155)
		end
	end)
end

-- ② 高性能ライムグリーンスライダー
local function createMenuSlider(parent, text, defaultVal)
	local item = Instance.new("Frame", parent)
	item.Size = UDim2.new(1, -10, 0, 36)
	item.BackgroundTransparency = 1
	
	local lbl = Instance.new("TextLabel", item)
	lbl.Size = UDim2.new(1, -60, 0, 15)
	lbl.Position = UDim2.new(0, 10, 0, 2)
	lbl.Text = text
	lbl.TextColor3 = Color3.fromRGB(130, 130, 135)
	lbl.TextSize = 11
	lbl.Font = Enum.Font.SourceSans
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.BackgroundTransparency = 1
	
	local valLbl = Instance.new("TextLabel", item)
	valLbl.Size = UDim2.new(0, 50, 0, 15)
	valLbl.Position = UDim2.new(1, -15, 0, 2)
	valLbl.Text = tostring(defaultVal)
	valLbl.TextColor3 = Color3.fromRGB(160, 210, 20)
	valLbl.TextSize = 11
	valLbl.TextXAlignment = Enum.TextXAlignment.Right
	valLbl.BackgroundTransparency = 1
	
	local track = Instance.new("TextButton", item)
	track.Size = UDim2.new(1, -20, 0, 4)
	track.Position = UDim2.new(0, 10, 0, 22)
	track.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
	track.Text = ""
	track.BorderSizePixel = 0
	
	local fill = Instance.new("Frame", track)
	fill.Size = UDim2.new(defaultVal / 100, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(160, 210, 20)
	fill.BorderSizePixel = 0
	
	local dragging = false
	local function update(input)
		local posX = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		fill.Size = UDim2.new(posX, 0, 1, 0)
		valLbl.Text = tostring(math.round(posX * 100))
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true update(input)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			update(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

-- ③ 見本のようなタイトル付きセクションカード（外枠）を作成する関数
local function createSectionBox(parent, size, pos, titleText)
	local box = Instance.new("Frame", parent)
	box.Size = size
	box.Position = pos
	box.BackgroundColor3 = Color3.fromRGB(22, 22, 25)
	box.BorderSizePixel = 0
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)
	
	local t = Instance.new("TextLabel", box)
	t.Size = UDim2.new(1, -20, 0, 24)
	t.Position = UDim2.new(0, 10, 0, 2)
	t.Text = titleText
	t.TextColor3 = Color3.fromRGB(255, 255, 255)
	t.TextSize = 12
	t.Font = Enum.Font.SourceSansBold
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.BackgroundTransparency = 1
	
	local scroll = Instance.new("ScrollingFrame", box)
	scroll.Size = UDim2.new(1, 0, 1, -28)
	scroll.Position = UDim2.new(0, 0, 0, 26)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 2
	local lay = Instance.new("UIListLayout", scroll)
	lay.Padding = UDim.new(0, 4)
	
	lay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		scroll.CanvasSize = UDim2.new(0, 0, 0, lay.AbsoluteContentSize.Y + 5)
	end)
	
	return scroll
end

